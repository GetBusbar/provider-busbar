apiVersion: v1
kind: Secret
metadata:
  name: example-creds
  namespace: crossplane-system
type: Opaque
stringData:
  # busbar admin-API credentials consumed by the Terraform provider config block.
  # endpoint + token are required; the TLS fields are optional (mTLS / private CA).
  credentials: |
    {
      "endpoint": "https://busbar-admin.internal:8081",
      "token": "REPLACE_WITH_ADMIN_TOKEN"
    }
